# Секрет для подписи JWT
JWT_SECRET=dev-secret-change-me

# ИИ-помощник кабинета. Если ключ пустой — работает офлайн-заглушка.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Распознавание голоса. Те же имена, что в сервисе «Подари» — ключ оттуда
# подходит как есть. В проде «Подари» шлюзом стоит ProxyAPI (российский,
# работает без VPN); можно указать любой OpenAI-совместимый адрес.
AI_BASE_URL=
AI_API_KEY=
AI_TRANSCRIBE_MODEL=whisper-1

# CORS: список origin через запятую или *
CORS_ORIGINS=*

# Базовый URL API для фронтенда
VITE_API_BASE_URL=http://localhost:8000
