# Секрет для подписи JWT сайта
JWT_SECRET=dev-secret-change-me

# Токен Telegram-бота (нужен для входа из Mini App по initData)
TELEGRAM_BOT_TOKEN=

# Порог зеркального мэтча, % (поднимаемый)
MATCH_THRESHOLD=40

# Разрешённые origin для CORS (через запятую) или *
CORS_ORIGINS=*

# Базовый URL API для фронтендов
VITE_API_BASE_URL=http://localhost:8000
